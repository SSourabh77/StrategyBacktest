      "close": "close",
      "volume": "volume",
      "expiry": "expiry",
      "strike": "strike",
      "option_type": "option_type"
    },
    "csv": {
      "date_folder_format": "%Y-%m-%d",
      "futures_glob": "*future*.csv",
      "options_glob": "*option*.csv"
    },
    "excel": {
      "file": "DATA/market_data.xlsx",
